	partition D_Scope = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\D_Scope.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Headers, {{"Scope", type text}, {"ScopeDesc", type text}, {"ScopeOrder", Int64.Type}}, "en-US")
				in
				    Types

	annotation PBI_ResultType = Table
