	column ScopeDesc
		dataType: string
		lineageTag: 40102700-d62a-5c65-92ad-68c97d63a965
		summarizeBy: none
		sourceColumn: ScopeDesc

		annotation SummarizationSetBy = Automatic

	column ScopeOrder
		dataType: int64
