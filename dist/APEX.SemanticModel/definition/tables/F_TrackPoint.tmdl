	partition F_TrackPoint = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\F_TrackPoint.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Headers, {{"CircuitId", type text}, {"PointOrder", Int64.Type}, {"X", type number}, {"Y", type number}, {"Longitude", type number}, {"Latitude", type number}}, "en-US")
				in
				    Types

	annotation PBI_ResultType = Table
