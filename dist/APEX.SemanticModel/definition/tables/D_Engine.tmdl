	partition D_Engine = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\D_Engine.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Headers, {{"EngineId", type text}, {"Engine", type text}, {"EngineCountry", type text}}, "en-US")
				in
				    Types

	annotation PBI_ResultType = Table
