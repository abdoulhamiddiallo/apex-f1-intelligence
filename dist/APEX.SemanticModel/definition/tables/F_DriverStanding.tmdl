	partition F_DriverStanding = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\F_DriverStanding.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Headers, {{"RaceKey", Int64.Type}, {"Year", Int64.Type}, {"Round", Int64.Type}, {"DriverId", type text}, {"StandingPoints", type number}, {"StandingPosition", Int64.Type}, {"ChampionshipWon", Int64.Type}, {"IsLatestRound", Int64.Type}}, "en-US")
				in
				    Types

	annotation PBI_ResultType = Table
