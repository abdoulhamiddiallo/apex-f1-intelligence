table Metrics
	lineageTag: 2c6dc41e-feae-5cbe-9a70-c64492bdef54

	/// Number of driver race entries in context
	measure 'Entries' = COUNTROWS ( F_Result )
		formatString: #,0
		lineageTag: 2f58067d-4055-5590-9625-1df001d7a786
		displayFolder: 01 Race record

	measure 'Grands Prix' = DISTINCTCOUNT ( F_Result[RaceKey] )
		formatString: #,0
		lineageTag: 48c326bf-ca9d-514d-a61a-61a1dd1097ce
		displayFolder: 01 Race record

	measure 'Wins' = CALCULATE ( COUNTROWS ( F_Result ), F_Result[IsWin] = 1 )
		formatString: #,0
		lineageTag: 7c039eb6-2677-5c98-9995-0cf48a0531ee
		displayFolder: 01 Race record

	measure 'Podiums' = CALCULATE ( COUNTROWS ( F_Result ), F_Result[IsPodium] = 1 )
		formatString: #,0
		lineageTag: a67fe7d0-8966-5994-b731-f3efda76d549
		displayFolder: 01 Race record

	measure 'Points' = SUM ( F_Result[Points] )
		formatString: #,0
		lineageTag: 52a93f58-102f-5688-96c3-93dfca6e91e1
		displayFolder: 01 Race record

	measure 'Poles' = CALCULATE ( COUNTROWS ( F_Result ), F_Result[IsPole] = 1 )
		formatString: #,0
		lineageTag: 3431784d-483c-522d-b0d5-1640b68ef500
		displayFolder: 01 Race record

	measure 'Fastest Laps' = CALCULATE ( COUNTROWS ( F_Result ), F_Result[IsFastestLap] = 1 )
		formatString: #,0
		lineageTag: 9de550b3-2c67-59b3-a5f8-a32797825ec5
		displayFolder: 01 Race record

	measure 'DNFs' = CALCULATE ( COUNTROWS ( F_Result ), F_Result[IsDNF] = 1 )
		formatString: #,0
		lineageTag: b318346c-767d-5722-ae9e-d93457fa1e75
		displayFolder: 01 Race record

	measure 'Points Finishes' = CALCULATE ( COUNTROWS ( F_Result ), F_Result[IsPoints] = 1 )
		formatString: #,0
		lineageTag: 3de966d2-ba06-56ea-a225-abe9a2f3c768
		displayFolder: 01 Race record

	measure 'Grand Slams' = CALCULATE ( COUNTROWS ( F_Result ), F_Result[IsGrandSlam] = 1 )
		formatString: #,0
		lineageTag: 36de2973-701d-5e10-b81f-6dd2a876aedc
		displayFolder: 01 Race record

	measure 'Driver of the Day' = CALCULATE ( COUNTROWS ( F_Result ), F_Result[IsDriverOfTheDay] = 1 )
		formatString: #,0
		lineageTag: a8ad2a26-6096-5cde-9c89-1f095b3de6aa
		displayFolder: 01 Race record

	measure 'Laps Completed' = SUM ( F_Result[LapsCompleted] )
		formatString: #,0
		lineageTag: ffe0548a-c8e5-53d1-a716-fb98585293c0
		displayFolder: 01 Race record

	measure 'Race Distance (km)' = SUMX ( VALUES ( D_Race[RaceKey] ), CALCULATE ( MAX ( D_Race[DistanceKm] ) ) )
		formatString: #,0
		lineageTag: 14b40465-8ef2-5a20-8d20-ff3808d27b90
		displayFolder: 01 Race record

	measure 'Sprint Wins' = CALCULATE ( COUNTROWS ( F_Sprint ), F_Sprint[IsSprintWin] = 1 )
		formatString: #,0
		lineageTag: af7300da-c930-5145-969e-ea6aa9e3ab0d
		displayFolder: 01 Race record

	measure 'Sprint Points' = SUM ( F_Sprint[SprintPoints] )
		formatString: #,0.##
		lineageTag: 743967ad-3a90-525c-9cc8-4df5c825483b
		displayFolder: 01 Race record

	measure 'Places Gained' = CALCULATE ( SUM ( F_Result[PositionsGained] ), F_Result[PositionsGained] > 0 )
		formatString: #,0
		lineageTag: 60621fa4-aaf9-5afa-82f8-0b0979edbb7c
		displayFolder: 01 Race record

	measure 'Win Rate' = DIVIDE ( [Wins], [Entries] )
		formatString: 0.0%
		lineageTag: 36f1f401-1674-5638-891e-3cdb0dd434ea
		displayFolder: 02 Rates & averages

	measure 'Podium Rate' = DIVIDE ( [Podiums], [Entries] )
		formatString: 0.0%
		lineageTag: ce547d77-4989-5d75-8870-577a9bbac249
		displayFolder: 02 Rates & averages

	measure 'Points Rate' = DIVIDE ( [Points Finishes], [Entries] )
		formatString: 0.0%
		lineageTag: 946e3e25-ff5b-5fef-b587-c6230607ac68
		displayFolder: 02 Rates & averages

	measure 'DNF Rate' = DIVIDE ( [DNFs], [Entries] )
		formatString: 0.0%
		lineageTag: 5eeb972a-8b7b-562e-9a58-ec6e93a8d396
		displayFolder: 02 Rates & averages

	measure 'Finish Rate' = DIVIDE ( [Entries] - [DNFs], [Entries] )
		formatString: 0.0%
		lineageTag: 25e7fb46-60cf-5fd3-91f0-90f60e331d63
		displayFolder: 02 Rates & averages

	measure 'Avg Finish' = AVERAGE ( F_Result[Position] )
		formatString: 0.0
		lineageTag: 94c6bb11-20d7-5141-b0ae-0eb7947f362e
		displayFolder: 02 Rates & averages

	measure 'Avg Grid' = AVERAGE ( F_Result[GridPosition] )
		formatString: 0.0
		lineageTag: 1060693a-8bca-59b8-9484-61f7b748296a
		displayFolder: 02 Rates & averages

	measure 'Avg Places Gained' = AVERAGE ( F_Result[PositionsGained] )
		formatString: +0.0;-0.0;0.0
		lineageTag: 8f93292d-c438-51b2-aecf-013b03298d3a
		displayFolder: 02 Rates & averages

	measure 'Points per Race' = DIVIDE ( [Points], [Entries] )
		formatString: 0.0
		lineageTag: ebec83db-8cf5-5440-b304-9e47851effbe
		displayFolder: 02 Rates & averages

	measure 'Best Finish' = MIN ( F_Result[Position] )
		formatString: 0
		lineageTag: 3976523b-26a8-5d1d-96db-f0c434defa3e
		displayFolder: 02 Rates & averages

	measure 'Pole to Win %' = DIVIDE ( CALCULATE ( COUNTROWS ( F_Result ), F_Result[WinFromPole] = 1 ), CALCULATE ( COUNTROWS ( F_Result ), F_Result[StartedFromPole] = 1 ) )
		formatString: 0.0%
		lineageTag: d2e839d0-2b97-5257-9ed3-56be7e78d01d
		displayFolder: 02 Rates & averages

	measure 'Points Share %' = DIVIDE ( [Points], CALCULATE ( [Points], ALLSELECTED ( D_Driver ), ALLSELECTED ( D_Constructor ) ) )
		formatString: 0.0%
		lineageTag: 0fe4fd59-f4c0-50e3-a3f9-864dc6451c7e
		displayFolder: 02 Rates & averages

	measure 'Championship Points' = SUMX ( VALUES ( F_DriverStanding[Year] ), VAR r = CALCULATE ( MAX ( F_DriverStanding[Round] ) ) RETURN CALCULATE ( SUM ( F_DriverStanding[StandingPoints] ), F_DriverStanding[Round] = r ) )
		formatString: #,0.##
		lineageTag: 73a84a57-55b3-52f5-b8a2-6c87f07b9833
		displayFolder: 03 Championship

	measure 'Championship Position' = MINX ( VALUES ( F_DriverStanding[Year] ), VAR r = CALCULATE ( MAX ( F_DriverStanding[Round] ) ) RETURN CALCULATE ( MIN ( F_DriverStanding[StandingPosition] ), F_DriverStanding[Round] = r ) )
		formatString: 0
		lineageTag: 1046599a-ce4e-5bff-b901-122f0f3c12a7
		displayFolder: 03 Championship

	measure 'Team Championship Points' = SUMX ( VALUES ( F_ConstructorStanding[Year] ), VAR r = CALCULATE ( MAX ( F_ConstructorStanding[Round] ) ) RETURN CALCULATE ( SUM ( F_ConstructorStanding[StandingPoints] ), F_ConstructorStanding[Round] = r ) )
		formatString: #,0.##
		lineageTag: 92cb2fef-4e58-5d69-9ab0-e395b4cf0b7e
		displayFolder: 03 Championship

	measure 'Team Championship Position' = MINX ( VALUES ( F_ConstructorStanding[Year] ), VAR r = CALCULATE ( MAX ( F_ConstructorStanding[Round] ) ) RETURN CALCULATE ( MIN ( F_ConstructorStanding[StandingPosition] ), F_ConstructorStanding[Round] = r ) )
		formatString: 0
		lineageTag: 0d76c4f2-fce6-5fa7-927c-547f27062a70
		displayFolder: 03 Championship

	measure 'Drivers Titles' = CALCULATE ( COUNTROWS ( F_DriverStanding ), F_DriverStanding[ChampionshipWon] = 1, F_DriverStanding[IsLatestRound] = 1 )
		formatString: 0
		lineageTag: 5658c437-8b0c-5e9a-9ec9-48f02ba76417
		displayFolder: 03 Championship

	measure 'Constructors Titles' = CALCULATE ( COUNTROWS ( F_ConstructorStanding ), F_ConstructorStanding[ChampionshipWon] = 1, F_ConstructorStanding[IsLatestRound] = 1 )
		formatString: 0
		lineageTag: f56420b9-e6da-5c99-9d86-465bc80de323
		displayFolder: 03 Championship

	measure 'Running Points' = SUM ( F_DriverStanding[StandingPoints] )
		formatString: #,0.##
		lineageTag: 89192093-baab-5cf4-b8c1-a874b45ff089
		displayFolder: 03 Championship

	measure 'Team Running Points' = SUM ( F_ConstructorStanding[StandingPoints] )
		formatString: #,0.##
		lineageTag: 6ed46b2e-fa1f-548f-9238-6739fd012cd5
		displayFolder: 03 Championship

	measure 'Circuit Length (km)' = MAX ( D_Circuit[LengthKm] )
		formatString: 0.000
		lineageTag: ae98128a-0a08-5a03-8d7f-215af2a42424
		displayFolder: 04 Circuit

	measure 'Circuit Turns' = MAX ( D_Circuit[Turns] )
		formatString: 0
		lineageTag: adac4df2-7372-5448-b7de-2f493a175eda
		displayFolder: 04 Circuit

	measure 'Grands Prix Held' = CALCULATE ( DISTINCTCOUNT ( D_Race[RaceKey] ), D_Race[IsRun] = 1 )
		formatString: #,0
		lineageTag: 4f9b5cfb-d74a-5e28-a1a8-c5e50f94f16e
		displayFolder: 04 Circuit

	measure 'First Grand Prix' = MIN ( D_Circuit[FirstGrandPrix] )
		formatString: 0
		lineageTag: ba768f13-8be8-5e34-beef-84af98a9bd2b
		displayFolder: 04 Circuit

	measure 'Different Winners' = CALCULATE ( DISTINCTCOUNT ( F_Result[DriverId] ), F_Result[IsWin] = 1 )
		formatString: 0
		lineageTag: 2880912b-a693-5ece-aaff-cbd7ef158ea9
		displayFolder: 04 Circuit

	measure 'Different Winning Teams' = CALCULATE ( DISTINCTCOUNT ( F_Result[ConstructorId] ), F_Result[IsWin] = 1 )
		formatString: 0
		lineageTag: 3fbfed30-c819-5c4c-a5cc-e3f194ede1c0
		displayFolder: 04 Circuit

	measure 'Lap Record ms' = MIN ( F_FastestLap[LapTimeMs] )
		formatString: #,0
		lineageTag: e0149445-e417-518c-9f64-6ff4b232ef8d
		displayFolder: 04 Circuit

	measure 'Lap Record' = VAR ms = [Lap Record ms] RETURN IF ( ISBLANK ( ms ), "n/a", FORMAT ( INT ( ms / 60000 ), "0" ) & ":" & FORMAT ( INT ( MOD ( ms, 60000 ) / 1000 ), "00" ) & "." & FORMAT ( MOD ( ms, 1000 ), "000" ) )
		lineageTag: 8405efc0-2ba3-5df8-b8b9-d5ee1995684c
		displayFolder: 04 Circuit

	measure 'Lap Record Holder' = VAR ms = [Lap Record ms] RETURN CALCULATE ( CONCATENATEX ( SUMMARIZE ( F_FastestLap, D_Driver[Driver] ), D_Driver[Driver], ", " ), F_FastestLap[LapTimeMs] = ms )
		lineageTag: acb97da9-888a-5b72-89a9-08c9afdc317f
		displayFolder: 04 Circuit

	measure 'Lap Record Year' = VAR ms = [Lap Record ms] RETURN CALCULATE ( MAX ( F_FastestLap[Year] ), F_FastestLap[LapTimeMs] = ms )
		formatString: 0
		lineageTag: 6339cf16-0e4d-5fb9-91fe-0fc163c9c606
		displayFolder: 04 Circuit

	measure 'Track Master' = VAR t = ADDCOLUMNS ( SUMMARIZE ( F_Result, D_Driver[Driver] ), "@w", CALCULATE ( COUNTROWS ( F_Result ), F_Result[IsWin] = 1 ) ) VAR bestrow = TOPN ( 1, FILTER ( t, [@w] > 0 ), [@w], DESC, [Driver], ASC ) RETURN IF ( ISEMPTY ( bestrow ), "n/a", MAXX ( bestrow, [Driver] ) & " · " & FORMAT ( MAXX ( bestrow, [@w] ), "0" ) & " wins" )
		lineageTag: 5cc88fa8-87b7-5bc8-84f1-383c4318998d
		displayFolder: 04 Circuit

	measure 'Track Master Team' = VAR t = ADDCOLUMNS ( SUMMARIZE ( F_Result, D_Constructor[Team] ), "@w", CALCULATE ( COUNTROWS ( F_Result ), F_Result[IsWin] = 1 ) ) VAR bestrow = TOPN ( 1, FILTER ( t, [@w] > 0 ), [@w], DESC, [Team], ASC ) RETURN IF ( ISEMPTY ( bestrow ), "n/a", MAXX ( bestrow, [Team] ) & " · " & FORMAT ( MAXX ( bestrow, [@w] ), "0" ) & " wins" )
		lineageTag: 10f01235-6c73-5315-a3df-389cde770521
		displayFolder: 04 Circuit

	measure 'Circuit Profile' = VAR l = [Circuit Length (km)] VAR t = [Circuit Turns] VAR ty = SELECTEDVALUE ( D_Circuit[CircuitType] ) VAR d = SELECTEDVALUE ( D_Circuit[Direction] ) RETURN IF ( ISBLANK ( l ), "n/a", FORMAT ( l, "0.000" ) & " km · " & FORMAT ( t, "0" ) & " turns · " & ty & " · " & d )
		lineageTag: 8831aa5b-f411-5331-9d36-a418e481a393
		displayFolder: 04 Circuit

	measure 'Rounds Scheduled' = DISTINCTCOUNT ( D_Race[RaceKey] )
		formatString: 0
		lineageTag: 6d4b98bc-deb0-59df-a347-9cc076fb9683
		displayFolder: 05 Season pulse

	measure 'Rounds Run' = CALCULATE ( DISTINCTCOUNT ( D_Race[RaceKey] ), D_Race[IsRun] = 1 )
		formatString: 0
		lineageTag: a4e8b974-8d20-5523-b93f-c39e43880320
		displayFolder: 05 Season pulse

	measure 'Rounds Remaining' = [Rounds Scheduled] - [Rounds Run]
		formatString: 0
		lineageTag: 6c0b8671-33ea-5ada-9ca7-230dd897436d
		displayFolder: 05 Season pulse

	measure 'Season Progress' = DIVIDE ( [Rounds Run], [Rounds Scheduled] )
		formatString: 0%
		lineageTag: 923b20f9-a7f5-5c8b-bc21-a8405e4f6b6b
		displayFolder: 05 Season pulse

	measure 'Championship Leader' = VAR t = ADDCOLUMNS ( VALUES ( D_Driver[Driver] ), "@p", [Championship Points] ) VAR bestrow = TOPN ( 1, FILTER ( t, [@p] > 0 ), [@p], DESC ) RETURN IF ( ISEMPTY ( bestrow ), "n/a", MAXX ( bestrow, [Driver] ) )
		lineageTag: 1f4e37a5-a37b-592c-a9cb-3d67cd64450b
		displayFolder: 05 Season pulse

	measure 'Leader Points' = MAXX ( ADDCOLUMNS ( VALUES ( D_Driver[Driver] ), "@p", [Championship Points] ), [@p] )
		formatString: #,0
		lineageTag: a6385031-925a-5014-89c0-944605588284
		displayFolder: 05 Season pulse

	measure 'Gap to Second' = VAR t = ADDCOLUMNS ( VALUES ( D_Driver[Driver] ), "@p", [Championship Points] ) VAR pair = TOPN ( 2, FILTER ( t, [@p] > 0 ), [@p], DESC ) RETURN MAXX ( pair, [@p] ) - MINX ( pair, [@p] )
		formatString: #,0
		lineageTag: d7d3b7f8-93ef-5162-b72a-1b1c4e8256c4
		displayFolder: 05 Season pulse

	measure 'Leading Team' = VAR t = ADDCOLUMNS ( VALUES ( D_Constructor[Team] ), "@p", [Team Championship Points] ) VAR bestrow = TOPN ( 1, FILTER ( t, [@p] > 0 ), [@p], DESC ) RETURN IF ( ISEMPTY ( bestrow ), "n/a", MAXX ( bestrow, [Team] ) )
		lineageTag: 6975c583-2602-5788-a60a-c7f27bfbdd0d
		displayFolder: 05 Season pulse

	measure 'Leading Team Points' = MAXX ( ADDCOLUMNS ( VALUES ( D_Constructor[Team] ), "@p", [Team Championship Points] ), [@p] )
		formatString: #,0
		lineageTag: 93043242-1f15-5583-bd88-b6601a862a25
		displayFolder: 05 Season pulse

	measure 'Last Race' = VAR k = CALCULATE ( MAX ( D_Race[SortKey] ), D_Race[IsRun] = 1 ) RETURN CALCULATE ( SELECTEDVALUE ( D_Race[GrandPrix] ), D_Race[SortKey] = k )
		lineageTag: 76dce3c9-0b51-5995-a945-58b095db206e
		displayFolder: 05 Season pulse

	measure 'Last Race Winner' = VAR k = CALCULATE ( MAX ( D_Race[SortKey] ), D_Race[IsRun] = 1 ) RETURN CALCULATE ( CONCATENATEX ( SUMMARIZE ( F_Result, D_Driver[Driver] ), D_Driver[Driver], ", " ), D_Race[SortKey] = k, F_Result[IsWin] = 1 )
		lineageTag: 532644a7-40ac-5efc-bffb-a4234cc340f8
		displayFolder: 05 Season pulse

	measure 'Last Race Date' = VAR k = CALCULATE ( MAX ( D_Race[SortKey] ), D_Race[IsRun] = 1 ) RETURN CALCULATE ( SELECTEDVALUE ( D_Race[RaceDate] ), D_Race[SortKey] = k )
		formatString: yyyy-mm-dd
		lineageTag: e466328f-4280-5855-8b61-4d3df247e717
		displayFolder: 05 Season pulse

	measure 'Next Race' = VAR k = CALCULATE ( MIN ( D_Race[SortKey] ), D_Race[IsRun] = 0 ) RETURN IF ( ISBLANK ( k ), "Season complete", CALCULATE ( SELECTEDVALUE ( D_Race[GrandPrix] ), D_Race[SortKey] = k ) )
		lineageTag: 62a4eeda-7254-5d70-9b23-7fcbef662a5c
		displayFolder: 05 Season pulse

	measure 'Next Race Circuit' = VAR k = CALCULATE ( MIN ( D_Race[SortKey] ), D_Race[IsRun] = 0 ) RETURN CALCULATE ( SELECTEDVALUE ( D_Race[Circuit] ), D_Race[SortKey] = k )
		lineageTag: 5f3a3843-d3e9-5961-8eb4-837b470d135a
		displayFolder: 05 Season pulse

	measure 'Next Race Date' = VAR k = CALCULATE ( MIN ( D_Race[SortKey] ), D_Race[IsRun] = 0 ) RETURN CALCULATE ( SELECTEDVALUE ( D_Race[RaceDate] ), D_Race[SortKey] = k )
		formatString: yyyy-mm-dd
		lineageTag: befbfdff-2fe3-576a-a8dd-fa5ded0172a2
		displayFolder: 05 Season pulse

	measure 'Season Headline' = VAR l = [Championship Leader] VAR p = [Leader Points] VAR g = [Gap to Second] VAR r = [Rounds Remaining] RETURN IF ( ISBLANK ( p ), "n/a", l & " leads on " & FORMAT ( p, "#,0" ) & " points, " & FORMAT ( g, "#,0" ) & " clear, with " & FORMAT ( r, "0" ) & " rounds to run." )
		lineageTag: 4ab489b2-f8fa-5cad-a13b-a520eabc0bbc
		displayFolder: 05 Season pulse

	measure 'Selected Metric' = SWITCH ( SELECTEDVALUE ( D_Metric[Metric], "Points" ), "Points", [Points], "Wins", [Wins], "Podiums", [Podiums], "Poles", [Poles], "Fastest laps", [Fastest Laps], "Avg finish", [Avg Finish], "DNFs", [DNFs] )
		lineageTag: 8adbe836-1a3d-5d4f-87df-2c1750661e97
		displayFolder: 06 Dynamic

	measure 'Selected Metric Label' = SELECTEDVALUE ( D_Metric[Metric], "Points" )
		lineageTag: 6fbe76e8-43c4-5471-b59c-cedc433c34f0
		displayFolder: 06 Dynamic

	measure 'Selected Metric Format' = SWITCH ( SELECTEDVALUE ( D_Metric[Metric], "Points" ), "Avg finish", "0.0", "#,0.##" )
		lineageTag: d1a9b50f-981b-5abd-9a0b-b64f41415ae0
		displayFolder: 06 Dynamic

	measure 'Scope Filter' = IF ( SELECTEDVALUE ( D_Scope[Scope], "All circuits" ) = "Classic eleven", CALCULATE ( [Selected Metric], D_Race[IsClassicCircuit] = 1 ), [Selected Metric] )
		lineageTag: 2231a417-563e-509e-b9c9-43928db47eea
		displayFolder: 06 Dynamic

	measure 'Scope Label' = SELECTEDVALUE ( D_Scope[ScopeDesc], "Every Grand Prix in the era" )
		lineageTag: b509eb97-59b3-5c57-9e77-b9951fe5c6d2
		displayFolder: 06 Dynamic

	measure 'Team Colour' = COALESCE ( SELECTEDVALUE ( D_Constructor[TeamColour] ), "#7A8496" )
		lineageTag: 79a2537f-f807-5bb7-a02a-7705b4b284a9
		displayFolder: 07 Visual helpers

	measure 'Driver Team Colour' = VAR t = ADDCOLUMNS ( SUMMARIZE ( F_Result, D_Constructor[TeamColour] ), "@n", CALCULATE ( COUNTROWS ( F_Result ) ) ) RETURN COALESCE ( MAXX ( TOPN ( 1, t, [@n], DESC ), [TeamColour] ), "#7A8496" )
		lineageTag: 61dc6352-4550-55e4-a201-993a85cf4470
		displayFolder: 07 Visual helpers

	measure 'Track Blueprint' = VAR ok = HASONEVALUE ( D_Circuit[CircuitId] ) VAR pts = CONCATENATEX ( F_TrackPoint, FORMAT ( F_TrackPoint[X], "0.0" ) & " " & FORMAT ( - F_TrackPoint[Y], "0.0" ), " L ", F_TrackPoint[PointOrder], ASC ) RETURN IF ( NOT ok || ISBLANK ( pts ), BLANK (), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='-112 -112 224 224' width='620' height='620'><path d='M " & pts & " Z' fill='none' stroke='%2320252F' stroke-width='21' stroke-linejoin='round' stroke-linecap='round'/><path d='M " & pts & " Z' fill='none' stroke='%23E9EDF5' stroke-width='10' stroke-linejoin='round' stroke-linecap='round'/><path d='M " & pts & " Z' fill='none' stroke='%23E8323C' stroke-width='1.6' stroke-dasharray='3 8' stroke-linecap='round'/></svg>" )
		lineageTag: 863bdffb-30cb-566e-915b-3c2407f0ae25
		displayFolder: 07 Visual helpers
		dataCategory: ImageUrl

	measure 'Selected Circuit' = COALESCE ( SELECTEDVALUE ( D_Circuit[Circuit] ), "All circuits" )
		lineageTag: ec95644c-0cee-5b36-b79c-793f6749043d
		displayFolder: 07 Visual helpers

	measure 'Selected Circuit Nickname' = COALESCE ( SELECTEDVALUE ( D_Circuit[Nickname] ), "" )
		lineageTag: d82a85ad-1589-5a65-9fe6-12ad6ed73dbf
		displayFolder: 07 Visual helpers

	measure 'Signature Corner' = COALESCE ( SELECTEDVALUE ( D_Circuit[SignatureCorner] ), "n/a" )
		lineageTag: 79786de1-1672-5b99-bed8-498727496159
		displayFolder: 07 Visual helpers

	measure 'Selected Season' = COALESCE ( SELECTEDVALUE ( D_Season[SeasonLabel] ), "2014 to 2026" )
		lineageTag: 404c8304-53ae-57fc-99f9-08569e154429
		displayFolder: 07 Visual helpers

	measure 'Pole Time ms' = MIN ( F_Qualifying[BestQualiMs] )
		formatString: #,0
		lineageTag: 8396d045-0aa2-5af0-baf0-e3357f7f29e9
		displayFolder: 08 Qualifying & pit lane

	measure 'Pole Time' = VAR ms = [Pole Time ms] RETURN IF ( ISBLANK ( ms ), "n/a", FORMAT ( INT ( ms / 60000 ), "0" ) & ":" & FORMAT ( INT ( MOD ( ms, 60000 ) / 1000 ), "00" ) & "." & FORMAT ( MOD ( ms, 1000 ), "000" ) )
		lineageTag: 07fc708e-8fa0-57b2-9141-8be9de836039
		displayFolder: 08 Qualifying & pit lane

	measure 'Q3 Appearances' = CALCULATE ( COUNTROWS ( F_Qualifying ), F_Qualifying[ReachedQ3] = 1 )
		formatString: #,0
		lineageTag: 7624e4e1-872d-549b-bf5d-91a7314f1a0e
		displayFolder: 08 Qualifying & pit lane

	measure 'Q3 Rate' = DIVIDE ( [Q3 Appearances], COUNTROWS ( F_Qualifying ) )
		formatString: 0.0%
